{
  "name": "hasta-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @hasta/web dev",
    "dev:lab": "pnpm --filter @hasta/lab dev",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy:lab": "wrangler deploy --config wrangler.lab.jsonc",
    "deploy:lab:check": "wrangler deploy --config wrangler.lab.jsonc --dry-run",
    "build": "pnpm --filter @66hex/hasta build && pnpm --filter @hasta/web build && pnpm --filter @hasta/lab build",
    "build:lab": "pnpm --filter @hasta/lab build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm build && pnpm test:run",
    "test:run": "pnpm --filter @66hex/hasta test:run && pnpm --filter @hasta/web test && pnpm --filter @hasta/lab test",
    "test:lab": "pnpm build:lab && pnpm --filter @hasta/lab test",
    "test:unit": "pnpm --filter @66hex/hasta test:unit",
    "test:browser": "pnpm build && pnpm test:browser:run",
    "test:browser:run": "pnpm --filter @66hex/hasta test:browser:run && pnpm --filter @hasta/web test && pnpm --filter @hasta/lab test",
    "check": "pnpm ci:quality && pnpm ci:e2e",
    "ci:quality": "pnpm format:check && pnpm lint && pnpm test:quality && pnpm test:release && pnpm typecheck && pnpm build && pnpm test:unit:run && pnpm pack:check",
    "ci:e2e": "pnpm test:browser:run",
    "audit:dependencies": "pnpm audit --audit-level=high",
    "test:unit:run": "node --test packages/hasta/tests/*.test.js",
    "test:release": "node --test scripts/release/*.test.mjs",
    "release:consumers": "node scripts/release/test-consumers.mjs",
    "pack:check": "pnpm --filter @66hex/hasta pack:check",
    "browsers:install": "playwright install chromium firefox webkit",
    "bench": "pnpm --filter @66hex/hasta bench",
    "test:frameworks": "pnpm --filter @66hex/hasta build && pnpm --filter @66hex/hasta test:frameworks",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "pnpm format && oxlint --fix . && pnpm format",
    "test:quality": "node --test scripts/quality.test.mjs",
    "icons:verify": "node --env-file-if-exists=.env apps/web/node_modules/nucleo-ui-outline-18/account-check.js"
  },
  "devDependencies": {
    "@aranlucas/oxlint-plugin-anti-slop": "0.1.1",
    "@playwright/test": "1.65.0",
    "@solidjs/vite-plugin": "3.0.1",
    "@solidjs/web": "2.0.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint-plugin-no-comment-slop": "0.6.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "solid-js": "2.0.3",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "svelte-min": "npm:svelte@5.32.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vue": "3.5.45",
    "wrangler": "4.162.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.28.3"
}
