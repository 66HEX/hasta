{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortImports": {
    "sortSideEffects": false
  },
  "sortPackageJson": true,
  "svelte": true,
  "ignorePatterns": [
    "packages/hasta/benchmarks/comparison/baseline-23e16ac/**",
    "packages/hasta/benchmarks/stability/baseline-fa9ac8d/**",
    "packages/hasta/benchmarks/stability/baseline-0a503bb/**",
    "packages/hasta/benchmarks/stability/baseline-5cf01cf/**",
    "packages/hasta/benchmarks/stability/baseline-d514639/**",
    "packages/hasta/benchmarks/stability/experimental/**",
    "docs/**",
    "**/dist/**",
    "**/coverage/**",
    "**/test-results/**",
    "**/playwright-report/**",
    "package-lock.json"
  ],
  "sortTailwindcss": {
    "stylesheet": "apps/web/src/styles.css",
    "functions": ["cn", "cva", "clsx"],
    "attributes": ["tw"]
  }
}
