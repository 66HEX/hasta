{
  "name": "@66hex/hasta",
  "version": "0.1.0",
  "description": "Geometry tracking and cursor trajectory prediction for browser interfaces.",
  "homepage": "https://hasta.madebyhex.com",
  "bugs": {
    "url": "https://github.com/66HEX/hasta/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/66HEX/hasta",
    "directory": "packages/hasta"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./vanilla": {
      "types": "./dist/vanilla/index.d.ts",
      "import": "./dist/vanilla/index.js",
      "default": "./dist/vanilla/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js",
      "default": "./dist/vue/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "import": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.core.json && tsc -p tsconfig.frameworks.json && svelte-check --workspace . --tsconfig ./tsconfig.frameworks.json",
    "test": "npm run build && npm run test:run",
    "check": "npm run typecheck && npm test && npm run pack:check",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build",
    "test:unit": "npm run build && node --test tests/*.test.js",
    "test:browser": "npm run build && npm run test:browser:run",
    "browsers:install": "playwright install chromium firefox webkit",
    "test:run": "node --test tests/*.test.js && playwright test && npm run test:frameworks",
    "test:browser:run": "playwright test && npm run test:frameworks",
    "bench": "npm run build && node benchmarks/runtime.mjs",
    "bench:prediction": "npm run build && node benchmarks/prediction.mjs",
    "bench:precision": "npm run build && node benchmarks/precision.mjs",
    "bench:comparison": "npm run build && node benchmarks/comparison/run.mjs",
    "bench:comparison:perf": "node benchmarks/comparison/perf.mjs",
    "bench:comparison:archive": "node benchmarks/comparison/archive.mjs",
    "bench:kalman": "npm run build && node benchmarks/comparison/kalman-experiment.mjs",
    "bench:stability": "npm run build && node benchmarks/stability/run.mjs",
    "bench:stability:lab": "node benchmarks/stability/lab-run.mjs",
    "bench:stability:perf": "node benchmarks/stability/perf.mjs",
    "test:frameworks": "playwright test -c playwright.frameworks.config.js"
  },
  "peerDependencies": {
    "react": ">=19 <20",
    "svelte": ">=5.32 <6",
    "vue": ">=3.5 <4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  }
}
